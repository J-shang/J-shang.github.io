---
import BaseLayout from './BaseLayout.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  title: string;
  description: string;
  topicTitle: string;
  topicHref: string;
  sectionTitle: string;
  date: Date;
  updated?: Date;
  cutoff?: Date;
  readtime?: number;
  headings?: Heading[];
  source?: {
    repository: string;
    path: string;
    url?: string;
    revision?: string;
    syncedAt?: Date;
    dirty?: boolean;
  };
}

const {
  title,
  description,
  topicTitle,
  topicHref,
  sectionTitle,
  date,
  updated,
  cutoff,
  readtime,
  headings = [],
  source,
} = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const fmt = (value: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(value);
---

<BaseLayout title={title} description={description} article>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow"><a href={topicHref}>{topicTitle}</a> / {sectionTitle}</p>
      <h1>{title}</h1>
      <p class="article-header__dek">{description}</p>
      <div class="article-meta">
        <span>发布 <strong>{fmt(date)}</strong></span>
        {updated && <span>更新 <strong>{fmt(updated)}</strong></span>}
        {cutoff && <span>信息截点 <strong>{fmt(cutoff)}</strong></span>}
        {readtime && <span>阅读 <strong>约 {readtime} 分钟</strong></span>}
      </div>
    </header>
    <div class="article-grid">
      <div class="article-content">
        <slot />
        {source && (
          <aside class="source-note">
            本文由学习材料同步整理而成。
            {source.url
              ? <>可在 <a href={source.url} target="_blank" rel="noreferrer">原始仓库</a> 查看 Markdown 源文档与版本历史。</>
              : <>来源：<code>{source.repository}</code> / <code>{source.path}</code>。</>}
            {source.dirty && <> 本次同步取自本地未提交工作树。</>}
            {source.revision && <> 同步版本：<code>{source.revision.slice(0, 12)}</code>。</>}
          </aside>
        )}
      </div>
      {toc.length > 0 && (
        <aside class="toc" aria-label="文章目录">
          <p class="toc__title">On this page</p>
          <ol>
            {toc.map((heading) => (
              <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </article>
  <script>
    import { renderMermaidDiagrams } from '../scripts/render-mermaid';

    const progress = document.querySelector('.reading-progress');
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const ratio = max > 0 ? scrollY / max : 0;
      if (progress instanceof HTMLElement) progress.style.width = `${Math.min(1, ratio) * 100}%`;
    };
    addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
    void renderMermaidDiagrams();
  </script>
</BaseLayout>
