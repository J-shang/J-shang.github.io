---
const path = Astro.url.pathname;
const isCurrent = (prefix: string) => prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="J. Shang 首页">
      <span class="brand__mark">J</span>
      <span>J. SHANG <span class="brand__sub">/ TECHNICAL NOTES</span></span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>首页</a>
      <a href="/topics/" aria-current={isCurrent('/topics/') ? 'page' : undefined}>专题</a>
      <a href="/notes/" aria-current={isCurrent('/notes/') ? 'page' : undefined}>文章</a>
      <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>关于</a>
      <button class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </div>
</header>
