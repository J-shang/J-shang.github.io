---
interface Props {
  href: string;
  title: string;
  description: string;
  label: string;
  date: Date;
  index?: number;
}

const { href, title, description, label, date, index = 1 } = Astro.props;
const formatted = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
---

<a class="post-card" href={href}>
  <div class="post-card__meta">
    <span>{label}</span>
    <span class="post-card__index">{String(index).padStart(2, '0')} / {formatted}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="post-card__arrow" aria-hidden="true">→</span>
</a>
