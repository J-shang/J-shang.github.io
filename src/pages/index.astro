---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
const guide = notes.find((note) => note.id === 'muon-system-guide');
const picks = ['megatron-muon-implementation', 'newton-schulz', 'token-flop-wall-clock']
  .map((id) => notes.find((note) => note.id === id))
  .filter(Boolean);
const categoryCounts = new Map();
for (const note of notes.filter((note) => note.data.category !== 'Muon 专题')) {
  categoryCounts.set(note.data.category, (categoryCounts.get(note.data.category) ?? 0) + 1);
}
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow">Independent technical writing / 2026</p>
      <h1 class="display">把复杂系统拆到<br /><span class="accent">可以验证。</span></h1>
      <p class="hero__dek">关于 AI 系统、优化器与规模化训练的长期技术笔记。追踪公式，也追踪公式进入代码之后发生了什么。</p>
      <div class="hero__actions">
        <a class="primary-action" href="/topics/muon/">开始阅读 Muon 专题 <span>→</span></a>
        <a class="secondary-action" href="https://github.com/J-shang" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <svg viewBox="0 0 620 620" role="img">
        <defs>
          <linearGradient id="signal" x1="0" y1="0" x2="1" y2="1"><stop stop-color="currentColor"/><stop offset="1" stop-color="currentColor" stop-opacity="0"/></linearGradient>
        </defs>
        <circle class="orbit orbit--outer" cx="310" cy="310" r="225"/>
        <circle class="orbit orbit--inner" cx="310" cy="310" r="128"/>
        <ellipse class="axis" cx="310" cy="310" rx="250" ry="88" transform="rotate(-32 310 310)"/>
        <ellipse class="axis axis--faint" cx="310" cy="310" rx="250" ry="88" transform="rotate(32 310 310)"/>
        <path class="vector" d="M164 413L438 178"/>
        <path class="vector vector--secondary" d="M190 176L443 420"/>
        <circle class="core" cx="310" cy="310" r="19"/>
        <circle class="node" cx="466" cy="148" r="12"/>
        <circle class="node node--warm" cx="111" cy="389" r="8"/>
        <text x="452" y="128">UVᵀ</text>
        <text x="122" y="434">M</text>
        <text class="formula" x="310" y="570" text-anchor="middle">M = UΣVᵀ  →  polar(M) = UVᵀ</text>
      </svg>
      <span class="visual-label visual-label--top">MATRIX GEOMETRY</span>
      <span class="visual-label visual-label--bottom">FIELD NOTE № 001</span>
    </div>
  </section>

  {guide && (
    <section class="featured shell">
      <div class="section-heading"><h2>当前专题</h2><span>FEATURED / 01</span></div>
      <a class="feature" href={`/notes/${guide.id}/`}>
        <div class="feature__number">μ</div>
        <div class="feature__content">
          <p class="eyebrow">Muon optimizer / System guide</p>
          <h2>{guide.data.title}</h2>
          <p>{guide.data.description}</p>
          <div class="feature__meta"><span>24 篇内容</span><span>5 条知识主线</span><span>信息截点 2026-07-01</span></div>
        </div>
        <span class="feature__arrow">↗</span>
      </a>
    </section>
  )}

  <section class="latest shell">
    <div class="section-heading"><h2>编辑精选</h2><a class="text-link" href="/notes/">浏览全部文章</a></div>
    <div class="card-grid">
      {picks.map((note, index) => note && <PostCard id={note.id} {...note.data} index={index + 1} />)}
    </div>
  </section>

  <section class="map shell">
    <div class="section-heading"><h2>知识地图</h2><span>FROM THEORY TO SYSTEMS</span></div>
    <div class="map__grid">
      {[...categoryCounts.entries()].map(([category, count], index) => (
        <a href={`/notes/?category=${encodeURIComponent(category)}`} class="map__item">
          <span class="map__index">0{index + 1}</span>
          <span class="map__name">{category}</span>
          <span class="map__count">{count} NOTES</span>
          <span class="map__line"></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { min-height: calc(100vh - 68px); display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: center; padding-block: 5rem; }
  .hero__copy { position: relative; z-index: 1; }
  .hero__dek { max-width: 640px; margin: 2rem 0 0; color: var(--ink-soft); font-size: clamp(1rem, 1.8vw, 1.25rem); line-height: 1.8; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.4rem; }
  .primary-action, .secondary-action { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 1.2rem; border: 1px solid var(--ink); font-size: .83rem; font-weight: 750; }
  .primary-action { gap: 2.2rem; background: var(--ink); color: var(--paper); }
  .primary-action:hover { background: var(--signal); border-color: var(--signal); color: white; }
  .secondary-action:hover { border-color: var(--signal); color: var(--signal); }
  .hero__visual { position: relative; color: var(--signal); }
  .hero__visual svg { width: 100%; }
  .orbit, .axis, .vector { fill: none; stroke: currentColor; stroke-width: 1.5; }
  .orbit--outer { stroke-dasharray: 3 9; }
  .orbit--inner { stroke: var(--line-strong); }
  .axis { stroke: var(--ink); stroke-width: 1; }
  .axis--faint { stroke: var(--line-strong); stroke-dasharray: 5 8; }
  .vector { stroke-width: 2; }
  .vector--secondary { stroke: var(--line-strong); stroke-dasharray: 5 7; }
  .core { fill: var(--ink); }
  .node { fill: var(--signal); }
  .node--warm { fill: var(--warm); }
  .hero__visual text { fill: var(--ink-soft); font-family: var(--mono); font-size: 15px; }
  .hero__visual .formula { font-size: 14px; letter-spacing: .04em; }
  .visual-label { position: absolute; color: var(--ink-soft); font-family: var(--mono); font-size: .62rem; letter-spacing: .12em; writing-mode: vertical-rl; }
  .visual-label--top { top: 8%; right: 2%; }
  .visual-label--bottom { bottom: 10%; left: 2%; transform: rotate(180deg); }
  .featured, .latest, .map { padding-top: 7rem; }
  .feature { display: grid; grid-template-columns: 180px 1fr auto; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; padding: clamp(1.5rem, 4vw, 3.5rem); border: 1px solid var(--line-strong); background: var(--paper-raised); box-shadow: var(--shadow); }
  .feature:hover { border-color: var(--signal); }
  .feature__number { display: grid; width: 150px; aspect-ratio: 1; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--signal); font-family: var(--serif); font-size: 6rem; }
  .feature h2 { margin: 0 0 .9rem; font-family: var(--serif); font-size: clamp(2rem, 4.4vw, 4rem); font-weight: 600; letter-spacing: -.05em; line-height: 1.12; }
  .feature__content > p:not(.eyebrow) { max-width: 680px; margin: 0; color: var(--ink-soft); }
  .feature__meta { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1.7rem; color: var(--ink-soft); font-family: var(--mono); font-size: .68rem; }
  .feature__arrow { align-self: start; color: var(--signal); font-size: 2rem; }
  .map { padding-bottom: 2rem; }
  .map__grid { border-top: 1px solid var(--line); }
  .map__item { display: grid; grid-template-columns: 70px 1fr auto; gap: 1rem; align-items: center; min-height: 90px; border-bottom: 1px solid var(--line); transition: padding 180ms ease; }
  .map__item:hover { padding-inline: 1rem; color: var(--signal); }
  .map__index, .map__count { color: var(--ink-soft); font-family: var(--mono); font-size: .7rem; }
  .map__name { font-family: var(--serif); font-size: clamp(1.3rem, 3vw, 2rem); }
  .map__line { display: none; }
  @media (max-width: 800px) {
    .hero { min-height: auto; grid-template-columns: 1fr; padding-top: 5rem; }
    .hero__visual { width: min(100%, 500px); margin-inline: auto; }
    .feature { grid-template-columns: 90px 1fr; }
    .feature__number { width: 82px; font-size: 3.4rem; }
    .feature__arrow { display: none; }
  }
  @media (max-width: 520px) {
    .hero__visual { margin-top: -1rem; }
    .feature { grid-template-columns: 1fr; }
    .feature__number { display: none; }
    .map__item { grid-template-columns: 44px 1fr auto; }
  }
</style>
