---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { loadSiteContent, noteHref, sectionTitle } from '../../lib/content';

const { topics, notes, topicById } = await loadSiteContent();
---

<BaseLayout title="全部文章" description="J. Shang 的 AI 系统、优化器、数据处理与规模化训练文章。">
  <section class="page-hero shell">
    <p class="eyebrow">Archive / Knowledge map</p>
    <h1>文章与知识地图</h1>
    <p>这里不是按热度排列的知识碎片。选择一条主线，从基础公式一路读到工程实现和实验判断。</p>
  </section>
  <section class="archive shell">
    <div class="filters">
      <div class="filter-row" role="group" aria-label="按专题筛选">
        <button class="filter is-active" data-topic="all">全部 <span>{notes.length}</span></button>
        {topics.map((topic) => <button class="filter" data-topic={topic.id}>{topic.data.shortTitle}</button>)}
      </div>
      <label class="search">
        <span>⌕</span>
        <input type="search" placeholder="搜索标题、摘要、专题或章节…" aria-label="搜索文章" />
      </label>
    </div>
    <p class="result-count"><span id="visible-count">{notes.length}</span> ARTICLES / FIELD NOTES</p>
    <div class="card-grid" id="archive-grid">
      {notes.map((note, index) => {
        const topic = topicById.get(note.data.topic);
        if (!topic) return null;
        const section = sectionTitle(topic, note.data.section);
        return (
          <div class="archive-item" data-topic={topic.id} data-search={`${note.data.title} ${note.data.description} ${topic.data.title} ${section}`.toLowerCase()}>
            <PostCard href={noteHref(note)} title={note.data.title} description={note.data.description} label={`${topic.data.shortTitle} · ${section}`} date={note.data.date} index={index + 1} />
          </div>
        );
      })}
    </div>
    <p class="empty" hidden>没有找到匹配文章。换一个关键词试试。</p>
  </section>
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const items = [...document.querySelectorAll<HTMLDivElement>('.archive-item')];
    const input = document.querySelector<HTMLInputElement>('.search input');
    const count = document.querySelector<HTMLElement>('#visible-count');
    const empty = document.querySelector<HTMLParagraphElement>('.empty');
    let topic = new URLSearchParams(location.search).get('topic') || 'all';
    let query = '';
    const render = () => {
      let visible = 0;
      items.forEach((element) => {
        const item = element;
        const topicMatch = topic === 'all' || item.dataset.topic === topic;
        const searchMatch = !query || item.dataset.search?.includes(query);
        const show = Boolean(topicMatch && searchMatch);
        item.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((button) => button.classList.toggle('is-active', button.dataset.topic === topic));
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };
    buttons.forEach((button) => button.addEventListener('click', () => { topic = button.dataset.topic || 'all'; render(); }));
    input?.addEventListener('input', () => { query = input.value.trim().toLowerCase(); render(); });
    render();
  </script>
</BaseLayout>

<style>
  .archive { padding-bottom: 2rem; }
  .filters { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem; padding-block: 1.2rem; border-block: 1px solid var(--line); }
  .filter-row { display: flex; flex-wrap: wrap; gap: .45rem; }
  .filter { padding: .4rem .7rem; border: 1px solid transparent; background: transparent; color: var(--ink-soft); font-size: .76rem; cursor: pointer; }
  .filter span { font-family: var(--mono); font-size: .62rem; }
  .filter:hover, .filter.is-active { border-color: var(--ink); color: var(--ink); }
  .filter.is-active { background: var(--ink); color: var(--paper); }
  .search { display: flex; min-width: min(280px, 100%); align-items: center; gap: .5rem; padding: .4rem .65rem; border-bottom: 1px solid var(--line-strong); }
  .search input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: .78rem; }
  .result-count { margin: 0 0 1.2rem; color: var(--ink-soft); font-family: var(--mono); font-size: .65rem; letter-spacing: .08em; }
  .archive-item[hidden] { display: none; }
  .archive-item :global(.post-card) { height: 100%; }
  .empty { padding: 5rem 0; color: var(--ink-soft); text-align: center; }
  @media (max-width: 760px) { .filters { align-items: stretch; flex-direction: column; } .search { min-width: 0; } }
</style>
