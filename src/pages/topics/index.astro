---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent, topicHref } from '../../lib/content';

const { topics, notes } = await loadSiteContent();
---

<BaseLayout title="全部专题" description="J. Shang Technical Notes 的长期技术学习专题。">
  <section class="page-hero shell">
    <p class="eyebrow">Topics / Learning paths</p>
    <h1>专题与学习路径</h1>
    <p>每个专题都有独立的章节结构、来源边界和阅读顺序，同时汇入全站文章索引。</p>
  </section>
  <section class="topics shell">
    {topics.map((topic, index) => {
      const count = notes.filter((note) => note.data.topic === topic.id).length;
      return (
        <a class="topic-card" href={topicHref(topic.id)}>
          <span class="topic-card__index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <p class="eyebrow">{topic.data.kicker}</p>
            <h2>{topic.data.title}</h2>
            <p>{topic.data.description}</p>
          </div>
          <div class="topic-card__meta">
            <span>{topic.data.sections.length} 条主线</span>
            <span>{count > 0 ? `${count} 篇内容` : '内容准备中'}</span>
            <b>↗</b>
          </div>
        </a>
      );
    })}
  </section>
</BaseLayout>

<style>
  .topics { display: grid; gap: 1rem; padding-bottom: 2rem; }
  .topic-card { display: grid; grid-template-columns: 70px 1fr 150px; gap: clamp(1.5rem, 5vw, 4rem); padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--line-strong); background: var(--paper-raised); }
  .topic-card:hover { border-color: var(--signal); box-shadow: var(--shadow); }
  .topic-card__index, .topic-card__meta { color: var(--ink-soft); font-family: var(--mono); font-size: .68rem; }
  .topic-card h2 { margin: 0 0 .8rem; font-family: var(--serif); font-size: clamp(2rem, 5vw, 4rem); font-weight: 600; letter-spacing: -.05em; }
  .topic-card div > p:last-child { max-width: 720px; margin: 0; color: var(--ink-soft); }
  .topic-card__meta { display: flex; align-items: flex-end; flex-direction: column; gap: .5rem; }
  .topic-card__meta b { margin-top: auto; color: var(--signal); font-size: 1.8rem; }
  @media (max-width: 700px) { .topic-card { grid-template-columns: 38px 1fr; } .topic-card__meta { grid-column: 2; align-items: flex-start; flex-direction: row; flex-wrap: wrap; } .topic-card__meta b { margin-left: auto; } }
</style>
